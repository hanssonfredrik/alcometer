{
  "routes": [
    {
      "route": "/privacy",
      "redirect": "https://app.promilla.se/privacy",
      "statusCode": 301
    },
    {
      "route": "/privacy.html",
      "redirect": "https://app.promilla.se/privacy",
      "statusCode": 301
    },
    {
      "route": "/img/*",
      "headers": { "cache-control": "public, max-age=604800" }
    },
    {
      "route": "/fonts/*",
      "headers": { "cache-control": "public, max-age=31536000, immutable" }
    }
  ],
  "responseOverrides": {
    "404": { "redirect": "/", "statusCode": 302 }
  }
}
